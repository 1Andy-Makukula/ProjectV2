{
  "rewrites": [
    {
      "source": "/:kind(shop|item|post|list|experience|gift)/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|facebookcatalog|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|Googlebot|bingbot|Applebot|SkypeUriPreview|embedly|Iframely|Bluesky|Mastodon).*"
        }
      ],
      "destination": "https://mbjbrdhpjgfhhycijodz.supabase.co/functions/v1/og?path=/:kind/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
