# Frontend (Vite) — copy to .env.local, never commit real values
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Error reporting. Not a secret — a DSN ships in the client bundle by design —
# but it is not committed either: a DSN in a public repo is an open ingestion
# endpoint anyone can flood, which exhausts the quota and buries real errors
# exactly when you need them. Unset means error reporting is off and the app
# logs a warning at startup.
# VITE_SENTRY_DSN=
#
# Fraction of transactions traced. Defaults to 0.1 in production builds and 1.0
# in development; set this only to override that.
# VITE_SENTRY_TRACES_SAMPLE_RATE=

# ===========================================================================
# FORMAT
# ===========================================================================
# KEY=value — no spaces around the `=`.
#
# `KEY = value` is read by some dotenv parsers but not by `source .env` in a
# shell, which treats it as a command and fails with "command not found". Two
# keys were added that way and were silently unreadable by any tooling that
# sources this file.

# ===========================================================================
# Supabase Edge Functions
# ===========================================================================
# These are NOT read from this file. Edge Functions only see secrets stored on
# the project. Putting a value here and expecting a deployed function to pick it
# up is a silent no-op — which is exactly what happened with
# OPEN_EXCHANGE_RATES_APP_ID.
#
# Set them with:
#   npx supabase secrets set KEY=value
# Inspect what is actually set (names and digests, never values):
#   npx supabase secrets list
#
# For local `supabase functions serve`, put them in supabase/functions/.env
# instead — already covered by .gitignore.
#
# --- Injected by the platform, never set by hand -------------------------
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY and
# SUPABASE_JWT_SECRET are provided to every deployed function automatically.
# They are listed here only so the set below reads as complete.
#
# --- Origins -------------------------------------------------------------
# APP_URL=https://your-production-app.example
# ALLOWED_ORIGINS=https://your-production-app.example,http://localhost:5173
#
# Echo back http://localhost:* and http://127.0.0.1:* Origins. Opt-in, and it
# must never be set on the deployed project: it lets any page running locally
# in a user's browser call these functions with their session attached. Needed
# only when developing against the hosted project. Local-only setups do not
# need it, because the APP_URL fallback is already http://localhost:5173.
# ALLOW_LOCAL_ORIGINS=true
#
# --- Payments ------------------------------------------------------------
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_SECRET=
#
# --- USSD ----------------------------------------------------------------
# Shared secret for the USSD aggregator.
# USSD_GATEWAY_SECRET=
#
# Accept the legacy plain-secret headers (X-Kithly-USSD-Secret /
# X-Gateway-Secret) as well as X-USSD-HMAC. Opt-in since 20260914: the plain
# header proves only that the sender knows the secret and covers nothing, so a
# captured request can be replayed verbatim against a real till. The HMAC path
# signs the body and cannot. Set this only while the aggregator cannot sign,
# and unset it the day they can.
# USSD_ALLOW_PLAIN_SECRET=true
#
# --- Notifications -------------------------------------------------------
# Absent from the project's secrets until 2026-08-09, so every WhatsApp
# dispatch was failing. There is still no SMS fallback: if WhatsApp cannot
# reach the recipient, the gift is not delivered at all.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
#
# The approved WhatsApp Business sender, e.g. whatsapp:+260... Without it
# send-notification refuses to send rather than fall back to Twilio's shared
# sandbox number, which only delivers to pre-opted-in handsets.
# TWILIO_WHATSAPP_FROM=
#
# Shared secret authorising server-to-server calls into send-notification.
# SEND_NOTIFICATION_SECRET=
#
# --- Scheduled jobs ------------------------------------------------------
# Shared secret authorising the pg_cron caller into batch-payout-sweeper.
# BATCH_PAYOUT_SWEEPER_SECRET=
#
# --- FX ------------------------------------------------------------------
# Used by fx-rate-lock and fx-snapshot. Never prefix either with VITE_ — that
# ships the key in the browser bundle.
# OPEN_EXCHANGE_RATES_APP_ID=
# EXCHANGERATE_API_KEY=

# ===========================================================================
# Staged, not active: escrow settlement rebuild
# ===========================================================================
# Read only by escrow-reconcile and _shared/airtel.ts, which are gated behind
# the `escrow_mode` setting and are not cut over. Nothing needs these to run
# the application today; they are listed so the set above stays complete.
#
# AIRTEL_BASE_URL=
# AIRTEL_CLIENT_ID=
# AIRTEL_CLIENT_SECRET=
# AIRTEL_COUNTRY=ZM
# AIRTEL_CURRENCY=ZMW
# AIRTEL_PIN=
# BANK_BALANCE_URL=
# BANK_BALANCE_TOKEN=

# ===========================================================================
# Retired
# ===========================================================================
# ENABLE_LEGACY_PAYOUT_SWEEPER gated the V1 sweeper. Per supabase/LEGACY.md it
# has never been set on any project, so the V1 path has never run. Do not set
# it.
#
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / REDIS_URL / FASTAPI_ENV
# belong to the fastapi-gateway, worker-engine, postgres-db and redis-queue
# services in docker-compose.yml. Those services are scaffolds that do nothing:
# per ADR 0002 and their own headers, fastapi-gateway answers 501 and
# worker-engine idles. Nothing in CI builds them and the application does not
# use them — the real database is Supabase.
#
# They are left in place because they were neutered deliberately rather than
# abandoned, and the decision to delete them is not a configuration one.
#
# This file previously carried a committed default database password for them.
# The value is deliberately not repeated here — it is still in git history, so
# treat it as burned and generate fresh secrets if those containers are ever
# run. No values appear above for the same reason.
