{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    // ES2022.Error is the `cause` option on the Error constructor, and nothing
    // else. Rethrowing without it discards the original error, which is how a
    // Flutterwave failure reaches Sentry as a bare "Network error or timeout"
    // with no gateway response attached. Engines that predate `cause` ignore
    // the second argument rather than throwing, so this degrades safely on old
    // Android WebViews.
    "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "supabase"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
